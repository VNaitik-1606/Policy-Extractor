{
  "manifest_version": 3,
  "name": "Policy Extractor",
  "version": "0.1.0",
  "description": "Extract selected policy fields from your authorized company portal, review them, and save records locally.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Policy Extractor"
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "web_accessible_resources": [
    {
      "resources": ["dashboard.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
